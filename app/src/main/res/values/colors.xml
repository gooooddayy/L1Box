<resources>


    <!--应用的主要色调,actionBar默认使用该颜色,Toolbar导航栏的底色 (L1Box 渐变绿)-->
    <color name="colorPrimary">#16a34a</color>
    <!--CheckBox,RadioButton,SwitchCompat等一般控件的选中效果默认采用该颜色 (L1Box 渐变绿)-->
    <color name="colorAccent">#4ade80</color>
    <!-- 渐变绿主题色: 启动图/顶部渐变使用 -->
    <color name="green_gradient_start">#15803d</color>
    <color name="green_gradient_end">#4ade80</color>
    <!-- 搜索页配色: 极浅淡绿页面底 + 站点选中态淡绿 -->
