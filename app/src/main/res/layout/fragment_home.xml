<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:paddingHorizontal="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/nameContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="160dp"
                android:text="@string/app_name"
                android:textAlignment="gravity"
                android:textColor="@color/text_foreground"
                android:textSize="16dp"
                android:drawablePadding="6dp"
                android:singleLine="true"
                android:drawableRight="@drawable/ic_arrow_down"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingVertical="4dp"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:hint="搜索影片 / 剧集"
            android:textColor="@color/text_foreground"
            android:textColorHint="#B3000000"
            android:textSize="14sp"
            android:drawablePadding="8dp"
            android:drawableTint="@color/colorPrimary"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="6dp"
            android:drawableLeft="@drawable/ic_search_18"/>

        <ImageView
            android:id="@+id/iv_collect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_collect_48"/>

        <ImageView
            android:id="@+id/iv_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_history_48"/>

    </LinearLayout>

    <!-- 首页内容区：支持下拉刷新 -->
    <com.github.tvbox.osc.view.HomeSwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.angcyo.tablayout.DslTabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:tab_indicator_drawable="@drawable/indicator_flash"
                app:tab_indicator_enable_flash="true"
                app:tab_indicator_enable_flash_clip="true"
                app:tab_indicator_height="5dp"
                app:tab_indicator_width="16dp"
                app:tab_select_color="@color/colorPrimary"
                app:tab_text_min_size="14dp"
                app:tab_text_max_size="16dp"
                app:tab_enable_gradient_text_size="false"
                app:tab_layout_scroll_anim="true"
                app:tab_scroll_anim_duration="320"
                android:layout_marginTop="6dp"
                >

            </com.angcyo.tablayout.DslTabLayout>

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/mViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                />
        </LinearLayout>
    </com.github.tvbox.osc.view.HomeSwipeRefreshLayout>

    <!-- 首页无订阅时的空状态：订阅入口 +（仅"配了源但装载失败"时）一句原因 -->
    <FrameLayout
        android:id="@+id/homeEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 默认隐藏：只有"有订阅地址却装载失败"时才显示，真没配源时观感与原来完全一致 -->
            <TextView
                android:id="@+id/tvEmptyTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="订阅加载失败，请检查源地址"
                android:textColor="@color/text_sub_foreground"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnGoSubscription"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_loading_pill"
                android:minWidth="140dp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:stateListAnimator="@null"
                android:text="添加订阅源"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
