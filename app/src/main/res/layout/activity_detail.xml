<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/previewPlayerPlace"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_40"
            android:paddingRight="@dimen/dp_50"
            android:paddingBottom="@dimen/dp_10">

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    >

                    <LinearLayout
                        android:id="@+id/ll_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="300dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="鬼灭之刃鬼灭之刃鬼灭之刃鬼灭之刃鬼灭之刃鬼灭之刃"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_foreground"
                            />

                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        >

                            <TextView
                                android:id="@+id/tvSite"
                                android:background="@drawable/bg_large_round_gray"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:singleLine="true"
                                tools:text="非凡影视"
                                android:textColor="@color/text_foreground"
                                android:drawableRight="@drawable/ic_change_20"
                                android:drawablePadding="4dp"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"/>

                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>
                        <!-- 外部播放：投屏左侧。点击弹出「系统播放器 + 已安装的外部播放器」，
                             地址复用当前预览播放器的最终地址，不额外取链 -->
                        <ImageView
                            android:id="@+id/tvExtPlayer"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginRight="8dp"
                            android:padding="7dp"
                            android:src="@drawable/ic_open_external"
                            app:tint="@color/text_foreground"
                            android:contentDescription="外部播放"
                            android:background="?android:selectableItemBackgroundBorderless"/>
                        <!-- 投屏：来源胶囊右侧（红圈标记处） -->
                        <ImageView
                            android:id="@+id/tvCast"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginRight="8dp"
                            android:padding="7dp"
                            android:src="@drawable/ic_cast"
                            app:tint="@color/text_foreground"
                            android:contentDescription="投屏"
                            android:background="?android:selectableItemBackgroundBorderless"/>
                        <ImageView
                            android:id="@+id/iv_private_browsing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:paddingLeft="10dp"
                            android:src="@drawable/ic_private_browsing"
                            android:visibility="gone"
                            tools:visibility="visible"
                            />
                    </LinearLayout>

                    <!-- 左半：收藏|历史 均分；右半：加入收藏(按文字宽度)|下载(占剩余)；竖杠 3 条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 左半边 50% -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tvCollectPage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/dp_40"
                                    android:drawableRight="@drawable/ic_colloct_18"
                                    android:drawablePadding="6dp"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:paddingHorizontal="10dp"
                                    android:text="收藏"
                                    android:textColor="@color/text_foreground" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="14dp"
                                android:background="@color/gray_darker"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tvHistoryPage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/dp_40"
                                    android:drawableRight="@drawable/ic_history_18"
                                    android:drawablePadding="6dp"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:paddingHorizontal="10dp"
                                    android:text="历史"
                                    android:textColor="@color/text_foreground" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 组间竖杠 -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="14dp"
                            android:layout_marginHorizontal="8dp"
                            android:background="@color/gray_darker"/>

                        <!-- 右半边 50%：加入收藏按文字宽度，下载吃剩余 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tvCollect"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp_40"
                                android:drawableRight="@drawable/ic_colloct_18"
                                android:drawablePadding="6dp"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:singleLine="true"
                                android:maxLines="1"
                                android:text="收藏"
                                android:textColor="@color/text_foreground" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="14dp"
                                android:background="@color/gray_darker"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:gravity="center">
                                <!-- 下载：纯图标，与左侧文字按钮同高对齐 -->
                                <ImageView
                                    android:id="@+id/tvDownload"
                                    android:layout_width="40dp"
                                    android:layout_height="@dimen/dp_40"
                                    android:padding="11dp"
                                    android:src="@drawable/ic_download_18"
                                    app:tint="@color/text_foreground"
                                    android:contentDescription="下载" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/bg_gray"
                        android:layout_marginVertical="4dp"/>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/mEmptyPlaylist"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/dp_128"
                        android:layout_height="@dimen/dp_128"
                        android:layout_gravity="center"
                        android:src="@drawable/icon_empty" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dp_10"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:gravity="center"
                        android:text="暂无播放数据"

                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/parse_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="解析"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="14dp"
                        android:layout_marginTop="8dp"
                        android:layout_centerVertical="true"
                        />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_parse"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_select_flag" />
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="线路"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_centerVertical="true"
                        />
                    <TextView
                        android:id="@+id/tvChangeLine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快捷换线"
                        android:drawableRight="@drawable/ic_change_20"
                        android:textColor="@color/text_foreground"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        android:paddingLeft="20dp"
                        android:layout_alignParentRight="true"
                        />
                </RelativeLayout>
                <!--        线路列表-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGridViewFlag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="4dp"
                    tools:listitem="@layout/item_select_flag"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:orientation="horizontal"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    >
                    <TextView
                        android:id="@+id/tv_series_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选集"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:layout_centerVertical="true"
                        android:textStyle="bold"
                        />

                    <Space
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/tvSort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="倒序"
                        android:drawableRight="@drawable/ic_sort_18"
                        android:textColor="@color/text_foreground"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        />

                    <View
                        android:id="@+id/line10"
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@color/gray_darker" />
                    <TextView
                        android:id="@+id/tv_all_series"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="展开全集"
                        android:drawableRight="@drawable/ic_expand_all_18"
                        android:textColor="@color/text_foreground"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        />
                </LinearLayout>
                <!--        集数列表-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGridView"
                    android:layout_width="match_parent"
                    android:layout_height="126dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:spanCount="3"
                    tools:orientation="vertical"
                    tools:listitem="@layout/item_series"/>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="match_parent"
        android:layout_height="250dp" />

</FrameLayout>
