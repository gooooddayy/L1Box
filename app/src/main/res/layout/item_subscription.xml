<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_subscription_card"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <!-- 行 1: 标题(粗体) ............ 三点菜单 + 启用开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_foreground"
            tools:text="自用"/>

        <ImageView
            android:id="@+id/iv_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="更多操作"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:tint="#555555"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- 行 2: URL 灰色截断 -->
    <TextView
        android:id="@+id/tv_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:ellipsize="middle"
        android:textColor="@color/text_sub_foreground"
        android:textSize="14sp"
        tools:text="https://gooooddayy.git..."/>

    <!-- 行 3: 多仓胶囊 + 使用源胶囊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_multi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_multi_tag"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="多仓"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/tv_use_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_sub_use_source"
            android:singleLine="true"
            android:maxWidth="200dp"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/text_foreground"
            android:textSize="13sp"
            tools:text="使用源:47.96.82..."
            tools:visibility="visible"/>
    </LinearLayout>
</LinearLayout>
