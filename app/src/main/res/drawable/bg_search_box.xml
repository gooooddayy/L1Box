<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索框：白底 + 浅绿描边，圆角 12dp 与整套 UI 统一 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="@color/green_stroke_soft" />
    <corners android:radius="12dp" />
    <padding
        android:left="12dp"
        android:top="6dp"
        android:right="12dp"
        android:bottom="6dp" />
</shape>
